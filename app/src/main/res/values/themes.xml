<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sahb" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/selected</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/selected</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text2</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/danger</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Sahb.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Sahb.Sheet</item>
    </style>

    <style name="ThemeOverlay.Sahb.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

    <style name="ThemeOverlay.Sahb.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="android:navigationBarColor">@color/card</item>
    </style>

    <style name="Sahb.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
    </style>
</resources>
