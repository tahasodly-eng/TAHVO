<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:menu="@menu/main_menu" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_tile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/home_headline"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/home_sub"
                android:textColor="@color/text2"
                android:textSize="17sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="28dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/illustration_convert" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pick"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/accent"
                android:text="@string/pick_file"
                android:textColor="@color/on_accent"
                android:textSize="19sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/on_accent" />

            <TextView
                android:id="@+id/share_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/or_share"
                android:textColor="@color/text2"
                android:textSize="15sp"
                app:drawableStartCompat="@drawable/ic_share"
                app:drawableTint="@color/text2" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
