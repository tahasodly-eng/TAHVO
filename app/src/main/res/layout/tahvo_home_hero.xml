<?xml version="1.0" encoding="utf-8"?>
<!-- TAHVO home screen: headline, link field, analyze button, platform shortcuts, recent downloads -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tahvo_hero"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="120dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tahvo_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tahvo_home_headline"
            android:textColor="?attr/colorOnSurface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/tahvo_home_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tahvo_url_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:hint="@string/tahvo_url_hint"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/tahvo_orange"
            app:endIconContentDescription="@string/tahvo_clear"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_link">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tahvo_url_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/tahvo_url_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="2"
                android:minHeight="56dp"
                android:textDirection="firstStrong" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tahvo_paste_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tahvo_paste"
                app:icon="@drawable/ic_clipboard" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tahvo_analyze_btn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/tahvo_orange"
            android:text="@string/tahvo_analyze_link"
            android:textColor="@color/tahvo_white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="29dp"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconTint="@color/tahvo_white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tahvo_browser_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/tahvo_browser_open"
            android:textColor="@color/tahvo_orange"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_tahvo_globe"
            app:iconGravity="textStart"
            app:iconTint="@color/tahvo_orange"
            app:strokeColor="@color/tahvo_orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tahvo_keyword_search_btn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="@string/tahvo_search_by_keywords"
            android:textColor="@color/tahvo_orange" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/tahvo_platforms"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tahvo_platforms_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <GridLayout
            android:id="@+id/tahvo_platforms_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="3"
            android:useDefaultMargins="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tahvo_recent_downloads"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tahvo_view_all_btn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tahvo_view_all"
                android:textColor="@color/tahvo_orange" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tahvo_recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tahvo_recent_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/tahvo_soft_card"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/tahvo_no_downloads_yet"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
